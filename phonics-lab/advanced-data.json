    {
      "id": "ai-ay",
      "title": "同じ音に、ちがうつづり",
      "kind": "B",
      "prerequisites": "文字の名前a /eɪ/。",
      "rule": "rainのaiとdayのayは、どちらも /eɪ/。同じ音でもつづりは1つとは限らないよ。aiは語の途中、ayは語の終わりによく出てくる。",
      "exception": "これはよくある位置の手がかり。音だけからaiかayかを必ず決められるわけではない。単語とつづりをいっしょに覚えよう。",
      "words": [
        "rain",
        "day"
      ],
      "questions": [
        {
          "id": "ai-same",
          "prompt": "rain の ai と day の ay の音は？",
          "options": [
            "同じ /eɪ/",
            "必ず別の音"
          ],
          "answer": 0,
          "feedback": "rain /reɪn/、day /deɪ/。つづりがちがっても、同じ音を表せるね。",
          "words": [
            "rain",
            "day"
          ]
        },
        {
          "id": "ay-place",
          "prompt": "day の /eɪ/ は、どのつづり？",
          "options": [
            "ai",
            "ay"
          ],
          "answer": 1,
          "feedback": "dayはay。これはdayという単語のつづりを確かめる問題だよ。",
          "words": [
            "day"
          ]
        }
      ],
      "researchIds": [
        "PH034",
        "PH035"
      ],
      "ruleStatus": "source-crosschecked",
      "sources": [
        "reading-rockets",
        "logic-of-english"
      ]
    },
    {
      "id": "oo",
