  "lessons": [
    {
      "id": "silent-e",
      "title": "eが付くと、音はどうなる？",
      "kind": "A",
      "prerequisites": "文字の名前・短い母音。cutのuを聞こう。",
      "rule": "母音1文字＋子音1文字＋読まないeでは、母音が文字の名前の音になることが多いよ。cut → cute では /ʌ/ → /juː/。eを1音ずつ足して読むのではないよ。",
      "exception": "have・giveでは母音が名前の音にならない。語末のeには、ほかの働きもあるよ。",
      "words": [
        "cut",
        "cute",
        "have",
        "give"
      ],
      "questions": [
        {
          "id": "e-change",
          "prompt": "cut と cute の、母音の音は？",
          "options": [
            "同じ",
            "変わる"
          ],
          "answer": 1,
          "feedback": "cut /kʌt/ と cute /kjuːt/。uの音が変わり、最後のeだけの音は足さないよ。",
          "words": [
            "cut",
            "cute"
          ]
        },
        {
          "id": "e-limit",
          "prompt": "最後にeがあれば、いつも母音は名前の音？",
          "options": [
            "いつもそうなる",
            "そうならない単語もある"
          ],
          "answer": 1,
          "feedback": "have /hæv/、give /ɡɪv/ も聞いてみよう。eだけでは決められないね。",
          "words": [
            "have",
            "give"
          ]
        }
      ],
      "researchIds": [
        "PH030",
        "PH033"
      ],
      "ruleStatus": "source-crosschecked",
      "sources": [
        "reading-rockets",
        "logic-of-english"
      ]
    },
    {
      "id": "ck",
      "title": "短い母音のすぐあと：ck",
      "kind": "A",
      "prerequisites": "短い母音 /ʌ/ と /ɑ/、子音 /k/。",
      "rule": "1音節の単語で、短い母音1つのすぐあとに最後の /k/ があると、ckと書くことが多いよ。duck・sockを見よう。",
      "exception": "どんな /k/ にもckを使うわけではない。母音のすぐあとか、単語の終わりかを見よう。",
      "words": [
        "duck",
        "sock"
      ],
      "questions": [
        {
          "id": "ck-end",
          "prompt": "duck の最後の /k/ を書くつづりは？",
          "options": [
            "ck",
            "tch",
            "dge"
          ],
          "answer": 0,
          "feedback": "duckは /d/ /ʌ/ /k/。短い母音のすぐあとで、ckが1つの /k/ を表すよ。",
          "words": [
            "duck"
          ]
        },
        {
          "id": "ck-position",
          "prompt": "duck・sockのckは、どこにある？",
          "options": [
            "短い母音のすぐあと・単語の終わり",
            "単語の先頭"
          ],
          "answer": 0,
          "feedback": "2つとも短い母音のすぐあとにあるね。ckを /k/ /k/ と2回読まないよ。",
          "words": [
            "duck",
            "sock"
          ]
        }
      ],
      "researchIds": [
        "PH010"
      ],
      "ruleStatus": "source-crosschecked",
      "sources": [
        "reading-rockets",
        "logic-of-english"
      ]
    },
    {
      "id": "tch",
      "title": "3文字で1つの音：tch",
      "kind": "A",
      "prerequisites": "短い母音と ch /tʃ/。",
      "rule": "1音節の単語で、短い母音1つのすぐあとに最後の /tʃ/ があると、tchと書くことが多いよ。catchのtchはまとめて1つの音。",
      "exception": "much・such・richなどは短い母音のあとでもch。絶対の書き方ではないよ。",
      "words": [
        "catch",
        "much"
      ],
      "questions": [
        {
          "id": "tch-fill",
          "prompt": "catch の最後の /tʃ/ を書くのは？",
          "options": [
            "ck",
            "tch",
            "dge"
          ],
          "answer": 1,
          "feedback": "catch /kætʃ/ の最後は3文字で /tʃ/。tの音を別に足さないよ。",
          "words": [
            "catch"
          ]
        },
        {
          "id": "tch-exception",
          "prompt": "much の最後も必ずtchに直す？",
          "options": [
            "直す",
            "muchのまま覚える"
          ],
          "answer": 1,
          "feedback": "much /mʌtʃ/ はch。短い母音のあとでも、この単語のつづりはそのまま覚えよう。",
          "words": [
            "much"
          ]
        }
      ],
      "researchIds": [
        "PH011"
      ],
      "ruleStatus": "source-crosschecked",
      "sources": [
        "reading-rockets",
        "logic-of-english"
      ]
    },
    {
      "id": "dge",
      "title": "3文字で1つの音：dge",
      "kind": "A",
      "prerequisites": "短い母音 /ɪ/ と j /dʒ/。",
      "rule": "1音節の単語で、短い母音1つのすぐあとに最後の /dʒ/ があると、dgeと書くことが多いよ。bridgeを聞こう。",
      "exception": "すべての /dʒ/ がdgeではない。条件を確かめ、単語のつづりも覚えよう。",
      "words": [
        "bridge"
      ],
      "questions": [
        {
          "id": "dge-fill",
          "prompt": "bridge の最後の /dʒ/ を書くのは？",
          "options": [
            "tch",
            "ck",
            "dge"
          ],
          "answer": 2,
          "feedback": "bridge /brɪdʒ/ は、短い /ɪ/ のすぐあとにdge。3文字をまとめて読むよ。",
          "words": [
            "bridge"
          ]
        }
      ],
      "researchIds": [
        "PH012"
      ],
